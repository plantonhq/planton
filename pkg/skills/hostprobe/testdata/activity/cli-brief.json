{
  "name": "cli-brief",
  "arm": "cli",
  "prompt": "Brief me on acme in prod: changes between 2026-10-08T12:00:00Z and 2026-10-09T12:00:00Z, current decisions, and unread failures. Show just the newest failure as an example and tell me the total. The connected instance is https://demo.example.invalid and I am priya. Do not change anything. The instance slug is demo, the account selector is priya@example.invalid, and there are no endpoint overrides. Only the CLI is available. Use the default page size.",
  "exchanges": [
    {
      "tool": "run_command",
      "input": {
        "argv": [
          "planton",
          "version"
        ]
      },
      "output": {
        "stdout": "Current version: v0.0.155",
        "exit_code": 0
      },
      "optional": true
    },
    {
      "tool": "run_command",
      "input": {
        "argv": [
          "planton",
          "activity",
          "--help"
        ]
      },
      "output": {
        "stdout": "activity [kind] [name|id]\n--failures --read-state all|unread|read --since --until --env --page-token --limit\nSubcommands: decisions, mark-read, mark-unread",
        "exit_code": 0
      },
      "optional": true
    },
    {
      "tool": "run_command",
      "input": {
        "argv": [
          "planton",
          "activity",
          "decisions",
          "--help"
        ]
      },
      "output": {
        "stdout": "Reads org-wide current decisions; omit --env. JSON contains complete and sources.",
        "exit_code": 0
      },
      "optional": true
    },
    {
      "tool": "run_command",
      "input": {
        "argv": [
          "planton",
          "activity",
          "decisions",
          "--instance",
          "demo",
          "--org",
          "acme",
          "--account",
          "priya@example.invalid",
          "-o",
          "json"
        ]
      },
      "output": {
        "stdout": "{\"complete\": false, \"sources\": [{\"source\": \"service_pipeline\", \"response\": {\"pending_decisions\": [{\"id\": \"environment/prod\", \"source_kind\": \"service_pipeline\", \"source_id\": \"svcpipe_checkout\", \"environment\": \"prod\", \"eligible\": true, \"waiting_since\": \"2026-10-01T08:00:00Z\"}, {\"id\": \"node/prod/db\", \"source_kind\": \"service_pipeline\", \"source_id\": \"svcpipe_checkout\", \"environment\": \"prod\", \"node_id\": \"db\", \"eligible\": true}]}}, {\"source\": \"infra_pipeline\", \"response\": {\"pending_decisions\": [{\"id\": \"approval\", \"source_kind\": \"infra_pipeline\", \"source_id\": \"infpipe_stage\", \"environment\": \"staging\", \"eligible\": true}]}}, {\"source\": \"infra_job\", \"error\": \"Infrastructure job decision queue unavailable\"}, {\"source\": \"assistant_finding\", \"response\": {}}]}",
        "exit_code": 1
