        "chart.go",
        "discover.go",
        "render.go",
        "validate.go",
        "values.go",
    ],
    importpath = "github.com/plantonhq/planton/pkg/infrachart",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/manifest",
        "//pkg/catalogkindreflect",
        "//pkg/deferrules",
        "//pkg/manifestgraph",
        "//pkg/reflection/metadatareflect",
        "//shared/catalogkind",
        "@build_buf_go_protovalidate//:protovalidate",
        "@com_github_nikolalohinski_gonja_v2//:gonja",
