# Local values for the StripePromotionCode module.
#
# An optional value the spec leaves at its zero value renders as null, so the provider never
# sends it and Stripe keeps its own default (an unset code is generated by Stripe). coupon
# arrives as a resolved coupon id: a reference to a StripeCoupon is resolved before this module
# runs.
locals {
  code             = try(var.spec.code, "") != "" ? var.spec.code : null
  customer         = try(var.spec.customer, "") != "" ? var.spec.customer : null
  customer_account = try(var.spec.customer_account, "") != "" ? var.spec.customer_account : null
  expires_at       = try(var.spec.expires_at, null)
  max_redemptions  = try(var.spec.max_redemptions, null)
  metadata         = length(try(var.spec.metadata, {})) > 0 ? var.spec.metadata : null
  # The spec's default is active; the provider needs the value only to deactivate.
  active = try(var.spec.active, null) == null ? true : var.spec.active

  restrictions = try(var.spec.restrictions, null) == null ? null : {
    first_time_transaction  = try(var.spec.restrictions.first_time_transaction, null)
    minimum_amount          = try(var.spec.restrictions.minimum_amount, null)
    minimum_amount_currency = try(var.spec.restrictions.minimum_amount_currency, "") != "" ? var.spec.restrictions.minimum_amount_currency : null
    # Sorted by currency so the provider's list never reorders between plans.
    currency_options = [
      for currency in sort(keys(try(var.spec.restrictions.currency_options, {}))) : {
        key            = currency
        minimum_amount = var.spec.restrictions.currency_options[currency]
      }
    ]
  }
}
