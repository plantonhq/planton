# ─── Go rules + Gazelle ──────────────────────────────────────────────────────
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")

# Pin the Go toolchain Bazel uses (hermetic; no host Go required)
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.6")
go_sdk.nogo(nogo = "//:planton_nogo")

# Read Go deps from this repo's go.mod (bzlmod-friendly)
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module(
    path = "buf.build/go/protovalidate",
    sum = "h1:pQqEQRpOo4SqS60qkvmhLTTQU9JwzEvdyiqAtXa5SeY=",
    version = "v1.1.0",
)
go_deps.module(
    path = "golang.org/x/tools",
    sum = "h1:yLkxfA+Qnul4cs9QA3KnlFu0lVmd8JJfoq+E41uSutA=",
    version = "v0.40.0",
)

# The Stigmer Go SDK ships a BUILD.bazel for its own repo's build, which makes
# Gazelle treat the module as pre-Bazelified and skip generating BUILD files
# for its packages (the vendored pb.go stub tree has none) -- every import
# then fails with "BUILD file not found". "clean" discards the shipped BUILD
# files and generates fresh ones from the Go sources.
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/stigmer/stigmer/sdk/go/v3",
)
use_repo(
