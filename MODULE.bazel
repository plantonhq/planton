# ─── Java rules (for Java stub compilation check) ────────────────────────────
# Generated Java protobuf stubs are compiled as a build-time gate to catch
# reserved keyword conflicts (e.g., "public", "class") before they reach
# downstream consumers.
bazel_dep(name = "rules_jvm_external", version = "6.9")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "javax.annotation:javax.annotation-api:1.3.2",
        # protobuf-java and io.grpc track the protoc / protoc-gen-grpc-java
        # pins in the Makefile's proto toolchain section, which are cross-repo
        # lockstepped with planton-platform (see the CROSS-REPO LOCKSTEP note
        # there). The platform runs this exact stack in production.
        "com.google.protobuf:protobuf-java:4.34.0",
        "io.grpc:grpc-api:1.79.0",
        "io.grpc:grpc-stub:1.79.0",
        "io.grpc:grpc-protobuf:1.79.0",
        # Pinned to the version the platform's control plane resolves (its
        # api-state pin test holds 1.1.1): the Java conformance gate below
        # hack/javagate proves every catalog CEL rule compiles on the exact
        # engine that validates these documents in production. A different
        # version here would gate against an engine nobody runs.
        "build.buf:protovalidate:1.1.1",
        "com.google.guava:guava:33.4.0-jre",
    ],
    repositories = ["https://repo.maven.apache.org/maven2"],
)
use_repo(maven, "maven")

