load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "protodefaults",
    srcs = [
        "applier.go",
        "type_converter.go",
    ],
    importpath = "github.com/plantonhq/planton/internal/manifest/protodefaults",
    visibility = ["//:__subpackages__"],
